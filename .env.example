# Public browser configuration, supplied at build/dev time.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server runtime configuration, required only for server operations.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Privileged: server secret manager only; never prefix with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=

# AI Studio preview / Node server listening port.
PORT=3000
